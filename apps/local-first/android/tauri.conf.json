{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Infinity Hybrid",
  "version": "0.1.0",
  "identifier": "run.hydro.infinityhybrid",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Infinity Hybrid",
        "width": 420,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
