{
  "name": "local-first-sync-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787 --persist-to .wrangler/state",
    "schema": "wrangler d1 execute local-first-sync --local --persist-to .wrangler/state --file schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.163.0"
  }
}
